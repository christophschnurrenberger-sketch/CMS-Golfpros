# Hochgeladene Dateien werden ausgeliefert, aber niemals ausgeführt.
# Das ist die wichtigste Regel überhaupt: Wer ein PHP-Skript als Bild
# hochlädt, hätte sonst Code auf dem Server.
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|cgi|sh|htaccess)$">
  Require all denied
</FilesMatch>
# SVG ist kein Bild wie die anderen: Es ist ein XML-Dokument und darf
# Skripte enthalten. Direkt im Browser geoeffnet laeuft dieses Skript im
# Namen der eigenen Website – als Logo in einem <img> dagegen nie.
# Deshalb wird die Datei nicht als Seite angezeigt, sondern zum Speichern
# angeboten, und zusaetzlich in einen Sandkasten gesperrt. Als Logo,
# Hintergrund oder Symbol funktioniert sie unveraendert weiter.
<FilesMatch "\.svgz?$">
  Header set Content-Disposition "attachment"
  Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
</FilesMatch>

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8

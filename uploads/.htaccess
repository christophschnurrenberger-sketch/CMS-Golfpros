# Hochgeladene Dateien werden ausgeliefert, aber niemals ausgeführt.
# Das ist die wichtigste Regel überhaupt: Wer ein PHP-Skript als Bild
# hochlädt, hätte sonst Code auf dem Server.
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|cgi|sh|htaccess)$">
  Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8
